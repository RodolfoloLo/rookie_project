# Root env for docker-compose.yml variable substitution
# Copy this file to .env and fill real values.
MYSQL_DATABASE=news_app
MYSQL_USER=app_user
MYSQL_PASSWORD=change_me_db_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# Optional: speed up Docker pip installs in restricted networks
PIP_INDEX_URL=https://pypi.org/simple

# Production image settings for docker-compose.prod.yml.
# Replace the owner with your GitHub username or organization name.
REGISTRY_IMAGE_BACKEND=ghcr.io/your-github-owner/headlines-backend
REGISTRY_IMAGE_FRONTEND=ghcr.io/your-github-owner/headlines-frontend
IMAGE_TAG=latest
